{
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "js/ts.preferences.importModuleSpecifier": "relative",
    "editor.codeActionsOnSave": {
        "source.removeUnusedImports": "explicit",
        "source.organizeImports": "explicit"
    },
    "files.exclude": {
        "**/.git": true,
        "**/node_modules": true
    },
    "search.exclude": {
        "**/node_modules": true,
        "**/dist": true
    },
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/node_modules/**": true,
        "**/tmp/**": true
    },
    "cSpell.words": [
        "WATCHPACK",
        "usecase",
        "usecases",
        "infopage",
        "myaddress",
        "todouhuken",
        "Todouhuken",
        "shikutyouson",
        "banchi",
        "Banchi",
        "meigi",
        "idcard",
        "hissu",
        "uriagekin",
        "honnin",
        "POSTNUMBER",
        "hira",
        "uriage"
    ]
}
