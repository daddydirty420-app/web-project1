{
  "name": "server",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/bin/www",
    "build": "tsc",
    "start": "node dist/bin/www",
    "mig:generate": "ts-node ./node_modules/sequelize-typescript-migration/dist/cli.js generate --sequelize-path src/setupModels.ts",
    "migration:generate": "sequelize-typescript-migration generate",
    "migration:run": "sequelize-cli db:migrate",
    "migration:revert": "sequelize-cli db:migrate:undo"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.884.0",
    "@aws-sdk/s3-request-presigner": "^3.913.0",
    "aws-sdk": "^2.1692.0",
    "axios": "^1.10.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "debug": "~2.6.9",
    "dotenv": "^16.6.1",
    "ejs": "~2.6.1",
    "express": "^4.19.2",
    "express-session": "^1.18.1",
    "http-errors": "~1.6.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "~1.9.1",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "pg": "^8.16.2",
    "sequelize": "^6.37.7",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/express-session": "^1.18.2",
    "@types/http-errors": "^2.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.19.25",
    "@types/pg": "^8.15.5",
    "@types/sequelize": "^4.28.20",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.1.10",
    "sequelize-auto-migrations": "^1.0.3",
    "sequelize-cli": "^6.6.3",
    "sequelize-mig": "^3.1.3",
    "sequelize-typescript-migration": "^0.0.1-beta.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}